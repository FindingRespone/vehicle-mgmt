generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VEHICLE_MEMBER
  ADMIN
  SUPER_ADMIN
  FINANCE_READONLY
}

enum VehicleStatus {
  IN_USE
  MAINTENANCE
  STOPPED
  DISPOSING
}

enum VehicleAvailability {
  AVAILABLE
  RISK
  UNAVAILABLE
}

enum PowerType {
  EV
  FUEL
}

enum VehicleClass {
  TRUCK_4_2
  OTHER
}

enum AttachmentCategory {
  DRIVING_LICENSE
  VEHICLE_PHOTO
  INSURANCE
  LOAN_CONTRACT
  OTHER
}

model User {
  id                String           @id @default(cuid())
  username          String           @unique
  password          String
  name              String
  role              Role
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  ownedVehicles     Vehicle[]        @relation("VehicleOwner")
  vehicleMemberships VehicleMember[]
  auditLogs         AuditLog[]
}

model Vehicle {
  id                      String               @id @default(cuid())
  plateNo                 String               @unique
  vin                     String?
  brandModel              String
  powerType               PowerType?
  vehicleClass            VehicleClass?
  status                  VehicleStatus        @default(IN_USE)
  availability            VehicleAvailability  @default(AVAILABLE)
  ownerUserId             String
  owner                   User                 @relation("VehicleOwner", fields: [ownerUserId], references: [id])
  annualInspectionDueAt   DateTime?
  drivingLicenseMeta      Json?
  driver                  String?
  remark                  String?              @db.Text
  lastLat                 Float?
  lastLng                 Float?
  lastLocateAt            DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  members                 VehicleMember[]
  insurancePolicies       InsurancePolicy[]
  loans                   Loan[]
  attachments             Attachment[]
  reminders               Reminder[]
  devices                 Device[]
  auditLogs               AuditLog[]

  @@index([ownerUserId])
  @@index([plateNo])
}

model VehicleMember {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([vehicleId, userId])
  @@index([userId])
}

model InsurancePolicy {
  id                  String       @id @default(cuid())
  vehicleId           String
  vehicle             Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  policyNo            String
  insuranceCompany    String
  insuranceType       String
  startDate           DateTime
  endDate             DateTime
  premium             Decimal      @db.Decimal(10, 2)
  remark              String?      @db.Text
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  attachments         Attachment[]

  @@index([vehicleId])
  @@index([endDate])
}

model Loan {
  id                String            @id @default(cuid())
  vehicleId         String
  vehicle           Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  lender            String
  contractNo        String?
  loanAmount        Decimal           @db.Decimal(12, 2)
  interestRate      Decimal           @db.Decimal(7, 4)
  startDate         DateTime
  endDate           DateTime
  monthlyPayment    Decimal           @db.Decimal(10, 2)
  installmentCount  Int
  remark            String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  attachments       Attachment[]
  installments      LoanInstallment[]

  @@index([vehicleId])
}

model LoanInstallment {
  id            String    @id @default(cuid())
  loanId        String
  loan          Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  periodNumber  Int
  dueDate       DateTime
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([loanId, periodNumber])
  @@index([loanId])
  @@index([dueDate])
}

model Attachment {
  id                 String              @id @default(cuid())
  category           AttachmentCategory
  filename           String
  originalFilename   String
  filepath           String
  filesize           Int
  mimeType           String
  vehicleId          String?
  vehicle            Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  insurancePolicyId  String?
  insurancePolicy    InsurancePolicy?    @relation(fields: [insurancePolicyId], references: [id], onDelete: Cascade)
  loanId             String?
  loan               Loan?               @relation(fields: [loanId], references: [id], onDelete: Cascade)
  uploadedBy         String?
  deletedAt          DateTime?
  supersededAt       DateTime?
  createdAt          DateTime            @default(now())

  @@index([vehicleId])
  @@index([insurancePolicyId])
  @@index([loanId])
  @@index([deletedAt])
}

enum ReminderStatus {
  PENDING
  SENT
  CONFIRMED
  SKIPPED
}

model Reminder {
  id            String          @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  sourceType    String
  sourceId      String?
  title         String
  description   String?         @db.Text
  dueDate       DateTime
  remindAt      DateTime
  offsetDays    Int
  channel       String          @default("inbox")
  status        ReminderStatus  @default(PENDING)
  payload       String?         @db.Text
  isCompleted   Boolean         @default(false)
  completedAt   DateTime?
  confirmedBy   String?
  confirmedAt   DateTime?
  sentAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([vehicleId])
  @@index([dueDate])
  @@index([remindAt, status])
  @@unique([vehicleId, sourceType, sourceId, offsetDays, channel])
}

model Device {
  id              String    @id @default(cuid())
  vehicleId       String?
  vehicle         Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  deviceId        String    @unique
  deviceType      String
  isActive        Boolean   @default(true)
  lastReportAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([vehicleId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicleId   String?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  action      String
  entityType  String
  entityId    String?
  changes     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([vehicleId])
  @@index([createdAt])
}
